# Directory where publication data is stored
DATA_DIR=/data

# qBittorrent connection
QB_HOST=qbittorrent
QB_PORT=8080
QB_USER=admin
QB_PASS=adminadmin

# Jackett (optional, for search)
JACKETT_URL=http://jackett:9117
JACKETT_KEY=your_jackett_api_key_here

# Cache behaviour
WARMUP_COUNT=2
WARMUP_DEPTH=3
CLIENT_TTL_DAYS=14

# Telegram bot token (from @BotFather)
BOT_TOKEN=123456789:AABBCCddEEFF...

# Telegram IDs of admins (comma-separated), e.g. 123456789,987654321
BOT_ADMIN_IDS=123456789

# Public base URL for serving files/RSS
WEB_BASE_URL=https://your-domain.com

# Content validation
MAX_FILE_SIZE_GB=5
MIN_AUDIO_RATIO=0.5
