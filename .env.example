# Directory where publication data is stored
DATA_DIR=/data

# qBittorrent connection
QB_HOST=qbittorrent
QB_PORT=8080
QB_USER=admin
QB_PASS=adminadmin

# Jackett (optional, for search)
JACKETT_URL=http://jackett:9117
JACKETT_KEY=your_jackett_api_key_here

# Cache behaviour
WARMUP_COUNT=2
WARMUP_DEPTH=3
CLIENT_TTL_DAYS=14

# Minimum free disk space to keep (GB). Below this, cached chapters are
# evicted globally (oldest last-requested first) regardless of per-book
# warmup windows.
MIN_FREE_DISK_GB=3

# Offload file serving to nginx via X-Accel-Redirect instead of streaming
# through this process (see deploy/nginx/*.conf). Leave off for local dev
# without nginx in front.
NGINX_ACCEL=false

# Telegram bot token (from @BotFather)
BOT_TOKEN=123456789:AABBCCddEEFF...

# Telegram IDs of admins (comma-separated), e.g. 123456789,987654321
BOT_ADMIN_IDS=123456789

# Public base URL for serving files/RSS
WEB_BASE_URL=https://your-domain.com

# Content validation
MAX_FILE_SIZE_GB=5
MIN_AUDIO_RATIO=0.5

# How long (seconds) to wait for a magnet link's metadata (file list) to
# arrive from peers/DHT, and how often to update the bot's status message
# with elapsed time + swarm diagnostics while waiting.
METADATA_TIMEOUT=300
METADATA_PROGRESS_INTERVAL=15
