[Unit]
Description=abooker Telegram bot (aiogram)
After=network.target abooker-web.service

[Service]
Type=simple
User=svp
Group=svp
WorkingDirectory=/home/svp/abooker
EnvironmentFile=/home/svp/abooker/.env
ExecStart=/home/svp/abooker/.venv/bin/abooker-bot
Restart=on-failure
RestartSec=5
MemoryMax=200M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=abooker-bot

[Install]
WantedBy=multi-user.target
